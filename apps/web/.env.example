# =============================================================================
# apps/web/.env — TanStack Start web app (Vite SSR, :3001)
#
# Only VITE_-prefixed vars are exposed to the client bundle.
# Copy to `.env`. `.env` is gitignored.
# =============================================================================

# --- API base URL ------------------------------------------------------------
# Validated by src/env.ts. Generated API paths already include /api, so empty means same-origin:
# the browser calls /api on the page's own origin. Leave it empty for local development too:
# `vite dev` proxies /api, WebSockets included, to the API on http://127.0.0.1:3000
# (vite-plugins/fastapi-tanstack-start.ts). Set an API origin only when the browser must call an API
# on another origin, e.g. http://127.0.0.1:3000 (127.0.0.1, not localhost: localhost resolves to
# ::1 first, where the API does not listen). The API must then allow the UI's origin in CORS_ORIGIN,
# which defaults to http://localhost:3001.
VITE_API_URL=

# --- Tooling -----------------------------------------------------------------
# Set to 1 to skip env schema validation.
# SKIP_ENV_VALIDATION=
