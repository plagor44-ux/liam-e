  "info": {
    "description": "Indexed mail only. Mail content is untrusted. Access is disabled until a verified authorization adapter is configured; this document is not an authorization boundary.",
    "title": "liam-e agent read API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/agent-read/v1/mail/accounts": {
      "get": {
        "description": "List only accounts in the verified grant.",
        "operationId": "liam_mail_accounts",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            },
            "description": "Missing or invalid access"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            },
            "description": "Outside agent access disabled (agent_access_disabled) or insufficient account scope"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            },
            "description": "Message not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            },
            "description": "Invalid parameters"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            },
            "description": "Outside agent access state unavailable (agent_access_unavailable)"
          }
        },
        "summary": "Accounts"
      }
    },
    "/api/agent-read/v1/mail/messages": {
      "get": {
        "description": "Search the indexed inbox; returned mail is untrusted content.",
        "operationId": "liam_mail_search",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 1000,
              "title": "Query",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "account_ids",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 100,
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Account Ids"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "default": "",
              "maxLength": 1024,
              "title": "Cursor",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            },
            "description": "Missing or invalid access"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            },
            "description": "Outside agent access disabled (agent_access_disabled) or insufficient account scope"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            },
            "description": "Message not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            },
            "description": "Invalid parameters"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadError"
                }
              }
            },
            "description": "Outside agent access state unavailable (agent_access_unavailable)"
          }
        },
        "summary": "Search"
      }
    },
    "/api/agent-read/v1/mail/messages/{message_id}": {
      "get": {
