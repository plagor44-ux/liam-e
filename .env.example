# =============================================================================
# The app's own settings: the committed declaration of every variable that YOUR code reads and
# that no capability declares. Names only: nothing loads this file.
#
# `.env` is generated by `mistral apps init` / `capability add` from the `envVars` of each
# installed capability, and it is gitignored. A setting you add in `packages/py/env/src/env/<name>.py`
# has no capability to declare it, so give it its default on the settings field and declare its
# name here, with no value:
#
#     # packages/py/env/src/env/my_feature.py:  my_feature_model: str = "mistral-medium-latest"
#     MY_FEATURE_MODEL=
#
# The field default applies wherever the variable is unset, so `.env` needs no matching line; add
# one to `.env` only to override it locally. Do not copy this file over `.env`: it holds no
# capability settings.
#
# `tests/test_composed_env_contract.py` (shipped by the testing capability) checks that every
# settings field is declared either by an installed capability or here, and that every line here
# is empty, so a default never lives in two places.
# =============================================================================

# Mail feature (packages/py/env/src/env/mail.py): names only — defaults live in the settings class.
MAIL_OAUTH_GOOGLE_CLIENT_ID=
MAIL_OAUTH_GOOGLE_CLIENT_SECRET=
MAIL_OAUTH_MICROSOFT_CLIENT_ID=
MAIL_OAUTH_MICROSOFT_CLIENT_SECRET=
MAIL_OAUTH_REDIRECT_BASE_URL=
MAIL_TOKEN_ENCRYPTION_KEY=
MAIL_IMAP_ALLOWED_HOSTS=
MAIL_SYNC_FOLDERS=
MAIL_SYNC_PAGE_SIZE=
MAIL_SYNC_MAX_BODY_CHARS=
MAIL_INSIGHT_MODEL=
MAIL_INSIGHT_BATCH_LIMIT=
MAIL_INSIGHT_DAYS=
MAIL_CHAT_MODEL=
MAIL_CHAT_MAX_TOOL_ROUNDS=

MAIL_WORKER_ENABLED=
MAIL_WORKER_POLL_SECONDS=
MAIL_SYNC_STALE_MINUTES=
MAIL_SYNC_INTERVAL_MINUTES=
CALENDAR_SYNC_INTERVAL_MINUTES=
CALENDAR_GOOGLE_SYNC_INTERVAL_MINUTES=

# Audio models and separately reviewed release evidence (packages/py/env/src/env/audio.py).
# Positive release evidence requires the studio_release scope, checked formats, and matching application limits.
AUDIO_STUDIO_OWNER=
AUDIO_DEVICE_TEST_UNTIL=
# Test-only live voice: explicit owner origin and a future ISO-8601 expiry within 72 hours.
# The test origin must match AUDIO_STUDIO_OWNER.origin. Disabled by default.
AUDIO_LIVE_TEST_ENABLED=
AUDIO_LIVE_TEST_ORIGIN=
AUDIO_LIVE_TEST_UNTIL=
AUDIO_STT_MODEL=
AUDIO_TTS_MODEL=
AUDIO_STT_VERIFICATION=
AUDIO_TTS_VERIFICATION=

# Native MCP Streamable HTTP transport (packages/py/env/src/env/mcp.py).
MCP_STUDIO_OWNER=
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_MAX_BODY_BYTES=
MCP_CALL_TIMEOUT_SECONDS=
MCP_RATE_LIMIT_REQUESTS=
MCP_RATE_LIMIT_WINDOW_SECONDS=
