# Dependencies
node_modules
.pnp
.pnp.js

# Build outputs
dist
build
*.tsbuildinfo

# Generated files
**/routeTree.gen.ts

# Environment variables
.env
.env*.local

# Mistral Studio IDs for tools/deploy.sh, only in a checkout that deploys; never commit them
# (AGENTS.md, "Publication and private data"). The file holds, with the real values:
#   {"organizationId": "<organization-id>", "workspaceId": "<workspace-id>", "appId": "<app-id>"}
/mistral.deployment.json
# The same for the synthetic MCP-route probe app (tools/probes/mcp_route_app/deploy.sh).
/tools/probes/mcp_route_app/mistral.deployment.json

# Local package-manager configuration (may contain tokens)
.npmrc

# Python / uv
.venv
**/.venv
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/

# IDEs and editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea
*.swp
*.swo
*~
.DS_Store

# Logs (directories root-only: a bare name also hides same-named source dirs at any depth)
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Nx
.nx

# Testing
coverage
.nyc_output
.coverage
.coverage.*
coverage.xml

# Misc (tmp/temp root-only, like logs/ above)
*.tgz
.cache
/tmp/
/temp/

# ./ingest is not ignored: it is the corpus Compose mirrors into the bucket, so it is committed.

# Agent scratch files and playwright-cli output (snapshots, console logs; written where it runs)
.omo
.sisyphus/
.scratch/
.playwright-cli/

# Local agent state: session buffers, code indexes, local Claude settings and worktrees. Never
# committed (AGENTS.md, "Publication and private data").
.superpowers/
.codegraph/
.remember/
.claude/settings.local.json
.claude/worktrees/
.playwright-mcp/
