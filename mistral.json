{
  "schemaVersion": 2,
  "kind": "app",
  "name": "liam-e",
  "deployment": {
    "organizationId": "ed70bb4c-f5a4-48f1-bd24-d0c67e5dffaa",
    "workspaceId": "a831098a-6d9f-4a72-be3c-4d7aedcfc0b9",
    "appId": "01a1f305-5288-7347-95f5-d7c938772fba"
  },
  "modules": [
    {
      "type": "app",
      "name": "api",
      "path": "apps/api",
      "routes": [
        {
          "path": "/api"
        }
      ],
      "port": 3000,
      "serve": "server",
      "runtime": "python",
      "build": {
        "context": ".",
        "dockerfile": "deploy/docker/Dockerfile.api",
        "target": "api"
      },
      "dev": {
        "startCommand": "uv run --all-packages python -m api.dev",
        "preStartCommands": [
          "uv run --all-packages python -m cli pre-start"
        ]
      },
      "deploy": {
        "startCommand": "uv run --frozen --no-dev --no-sync uvicorn api.main:app --host \"$HOST\" --port \"$PORT\" --proxy-headers --timeout-graceful-shutdown 20",
        "preStartCommands": [
          "uv run --frozen --no-dev --no-sync python -m cli pre-start"
        ]
      }
    },
    {
      "type": "app",
      "name": "web",
      "path": "apps/web",
      "routes": [
        {
          "path": "/"
        }
      ],
      "port": 3001,
      "serve": "static",
      "runtime": "node",
      "build": {
        "context": ".",
        "dockerfile": "deploy/docker/Dockerfile.web",
        "target": "runtime"
      },
      "dev": {
        "startCommand": "bun run dev"
      },
      "deploy": {
        "startCommand": "node .output/server/index.mjs"
      }
    },
    {
      "type": "managed",
      "name": "postgres",
      "engine": "postgres"
    }
  ]
}
